GROQ_API_KEY=your_groq_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp
CHROMA_PATH=./data/chroma
PDF_STORAGE_PATH=./data/pdfs
CHATS_PATH=./data/chats
CORS_ORIGINS=*
USE_HYBRID_SEARCH=true
# Off by default on Windows (Qwen+BGE same process → crash 3221225477)
USE_CROSS_ENCODER=false
MAX_AGENT_STEPS=15
FIRECRAWL_DEFAULT_CRAWL_LIMIT=10
FIRECRAWL_MAX_CRAWL_LIMIT=25

# Supermemory-first (local Chroma/Qwen kept in code but disabled)
LOCAL_RAG_ENABLED=false
RAG_PROVIDER=supermemory
RAG_FALLBACK_TO_LOCAL=false
SUPERMEMORY_API_KEY=
SUPERMEMORY_BASE_URL=https://api.supermemory.ai

# Gmail/GitHub OAuth connectors + uploads share user_<NERVA_USER_ID>
NERVA_USER_ID=shubham
SUPERMEMORY_CONTAINER_TAG=user_shubham
CONNECTIONS_REDIRECT_URL=http://localhost:3000/?integrations=connected

# Google OAuth (Gmail + Calendar — tokens stored server-side only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:3000

# LiveKit worker → FastAPI credential bridge for Google Workspace MCP
# local = read tokens from backend/data/google_oauth (same machine)
# api   = fetch Bearer headers from FastAPI /auth/google/mcp/headers
GOOGLE_MCP_CREDENTIAL_MODE=local
GOOGLE_MCP_BRIDGE_URL=http://127.0.0.1:8000/auth/google/mcp/headers
GOOGLE_MCP_BRIDGE_SECRET=

# GitHub remote MCP (voice agent only — never expose to frontend)

# Telegram Nerva interface (Supermemory only — separate from LiveKit voice)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: set the same value in setWebhook secret_token and verify header
TELEGRAM_WEBHOOK_SECRET=
